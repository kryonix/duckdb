# name: benchmark/recursive_cte/adaptive_probe_sparse_left.benchmark
# group: [recursive_cte]

name Recursive CTE sparse adaptive LEFT probe
group Recursive CTE

# Keep the recurring state on the build side so this operator-level benchmark exercises the adaptive probe.
init
SET disabled_optimizers = 'build_side_probe_side';

run benchmark/recursive_cte/queries/performance/adaptive_probe_sparse_left.sql

result benchmark/recursive_cte/answers/performance/adaptive_probe_sparse_left.csv
