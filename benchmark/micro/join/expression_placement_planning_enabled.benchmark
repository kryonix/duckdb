# name: benchmark/micro/join/expression_placement_planning_enabled.benchmark
# description: Plan expression placement and protection queries with the optimizer enabled
# group: [join]

template benchmark/micro/join/expression_placement_planning.benchmark.in
QUERY_NAME=Expression Placement Planning Enabled
DISABLED_OPTIMIZERS=''
SELECT_LIST=hash(a, b, c, d, e, f, g, h)
FROM_CLAUSE=expression_placement_plan_probe JOIN expression_placement_plan_build USING (i)
