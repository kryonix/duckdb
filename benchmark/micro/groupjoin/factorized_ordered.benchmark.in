# description: Selective two-factor GroupJoin with ordered branch aggregates
# group: [groupjoin]

name Factorized GroupJoin ordered ${LABEL} (R=${driver_rows}, fanout=${fanout}, match=${match_rate}%, unmatched=${unmatched_multiplier}x)
group micro
subgroup groupjoin

argument driver_rows 20000
argument fanout 16
argument match_rate 1
argument unmatched_multiplier 4
argument key_spacing 4
argument groupjoin_threads 4

load
SET threads TO ${groupjoin_threads};
SET debug_group_join_strategy TO '${STRATEGY}';
SET disabled_optimizers TO '${DISABLED_OPTIMIZERS}';
CREATE TABLE factor_driver(k BIGINT PRIMARY KEY);
INSERT INTO factor_driver SELECT i * ${key_spacing} FROM range(${driver_rows}) t(i);
CREATE TABLE factor_left(k BIGINT, x BIGINT);
INSERT INTO factor_left
SELECT k * ${key_spacing}, repeat_index
FROM range((${driver_rows} * ${match_rate}) // 100) keys(k), range(${fanout}) repeats(repeat_index);
INSERT INTO factor_left
SELECT (unmatched_key % ${driver_rows}) * ${key_spacing} + 1, repeat_index
FROM range(${driver_rows} * ${unmatched_multiplier}) keys(unmatched_key), range(${fanout}) repeats(repeat_index);
CREATE TABLE factor_right(k BIGINT, y BIGINT);
INSERT INTO factor_right
SELECT k * ${key_spacing}, repeat_index
FROM range((${driver_rows} * ${match_rate}) // 100) keys(k), range(${fanout}) repeats(repeat_index);
INSERT INTO factor_right
SELECT (unmatched_key % ${driver_rows}) * ${key_spacing} + 2, repeat_index
FROM range(${driver_rows} * ${unmatched_multiplier}) keys(unmatched_key), range(${fanout}) repeats(repeat_index);

run
SELECT count(*), sum(length(xs)), sum(length(ys)), sum(list_sum(xs)), sum(list_sum(ys)),
	   sum(list_first(xs)), sum(list_last(xs)), sum(list_first(ys)), sum(list_last(ys))
FROM (
	SELECT r.k, list(s.x ORDER BY s.x) AS xs, list(t.y ORDER BY t.y DESC) AS ys
	FROM factor_driver r JOIN factor_left s USING (k) JOIN factor_right t USING (k)
	GROUP BY r.k
) groups;

result_query I
WITH parameters AS (
	SELECT ((${driver_rows}::HUGEINT * ${match_rate}) // 100) AS group_count,
	       ${fanout}::HUGEINT AS fanout
), expected AS (
	SELECT group_count::BIGINT AS group_count,
	       group_count * fanout * fanout AS left_length,
	       group_count * fanout * fanout AS right_length,
	       group_count * fanout * fanout * (fanout - 1) // 2 AS left_sum,
	       group_count * fanout * fanout * (fanout - 1) // 2 AS right_sum,
	       0::HUGEINT AS left_first,
	       group_count * (fanout - 1) AS left_last,
	       group_count * (fanout - 1) AS right_first,
	       0::HUGEINT AS right_last
	FROM parameters
)
SELECT count(*) FROM (
	(SELECT * FROM __answer EXCEPT ALL SELECT * FROM expected)
	UNION ALL
	(SELECT * FROM expected EXCEPT ALL SELECT * FROM __answer)
) differences;
----
0
