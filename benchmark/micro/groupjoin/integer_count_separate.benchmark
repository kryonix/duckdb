# name: benchmark/micro/groupjoin/integer_count_separate.benchmark
# group: [groupjoin]

template benchmark/micro/groupjoin/groupjoin.benchmark.in
LABEL=integer/count/separate
STRATEGY=disabled
DISABLED_OPTIMIZERS=partial_aggregate_pushdown,top_n
KEY_COLUMNS=int_key
AGGREGATES=count(*) AS row_count
SUMMARY=count(*) AS group_count, sum(row_count) AS match_count
