# name: benchmark/micro/groupjoin/integer_1agg_eager.benchmark
# group: [groupjoin]

template benchmark/micro/groupjoin/groupjoin.benchmark.in
LABEL=integer/1 aggregate/eager
STRATEGY=disabled
DISABLED_OPTIMIZERS=top_n
KEY_COLUMNS=int_key
AGGREGATES=sum(value) AS total_value
SUMMARY=count(*) AS group_count, sum(total_value) AS total_value
