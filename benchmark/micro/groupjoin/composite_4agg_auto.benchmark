# name: benchmark/micro/groupjoin/composite_4agg_auto.benchmark
# group: [groupjoin]

template benchmark/micro/groupjoin/groupjoin.benchmark.in
LABEL=composite/4 aggregates/auto
STRATEGY=auto
DISABLED_OPTIMIZERS=top_n
KEY_COLUMNS=int_key, tail
AGGREGATES=count(*) AS row_count, sum(value) AS total_value, min(value) AS min_value, max(value) AS max_value
SUMMARY=count(*) AS group_count, sum(row_count) AS match_count, sum(total_value) AS total_value, sum(min_value) AS min_sum, sum(max_value) AS max_sum
