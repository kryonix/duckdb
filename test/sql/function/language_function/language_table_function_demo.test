# name: test/sql/function/language_function/language_table_function_demo.test
# description: Language table function behavior with a registered binder (testlang demo extension)
# group: [language_function]

# Language function tests manage their own storage version (persistent entries need v2.1.0+)
require noforcestorage

require skip_reload

require allow_unsigned_extensions

statement ok
LOAD '{BUILD_DIRECTORY}/test/extension/language_function_demo.duckdb_extension';

# the binder validates table definitions at CREATE time
statement error
CREATE FUNCTION rejected_tf() RETURNS TABLE(i INTEGER) LANGUAGE testlang AS 'rows:invalid';
----
<REGEX>:.*testlang: the source of "rejected_tf" may not contain.*

# testlang table sources must have the form 'rows:<n>'
statement error
CREATE FUNCTION malformed_tf() RETURNS TABLE(i INTEGER) LANGUAGE testlang AS 'not a row spec';
----
<REGEX>:.*testlang: the source of table function "malformed_tf" must have the form 'rows:<n>'.*

# a testlang table function emits the rows its source denotes, renamed and cast to the declared schema
statement ok
CREATE FUNCTION numbers(n INTEGER) RETURNS TABLE(i INTEGER, tag VARCHAR) LANGUAGE testlang AS 'rows:3';

query IT
SELECT i, tag FROM numbers(1);
----
0	0
1	1
2	2

# the declared schema is authoritative for the result types
query TT
SELECT typeof(i), typeof(tag) FROM numbers(1) LIMIT 1;
----
INTEGER	VARCHAR

# argument resolution errors surface before the language binder runs
statement error
SELECT * FROM numbers();
----
<REGEX>:.*Binder Error.*

# 'rows:arg:<i>' takes the row count from the i-th UNEVALUATED argument: arbitrary expressions work
statement ok
CREATE FUNCTION arg_rows(n) RETURNS TABLE(i BIGINT) LANGUAGE testlang AS 'rows:arg:0';

query I
SELECT count(*) FROM arg_rows(1 + 2);
----
3

# ... including correlated (lateral) arguments: the seam runs before argument evaluation
statement ok
CREATE TABLE t(x INTEGER);

statement ok
INSERT INTO t VALUES (1), (2), (0);

query II
SELECT t.x, r.i FROM t, arg_rows(t.x) r ORDER BY t.x, r.i;
----
1	0
2	0
2	1

query II
SELECT t.x, r.i FROM t, LATERAL arg_rows(t.x) r ORDER BY t.x, r.i;
----
1	0
2	0
2	1

# default parameters are filled in before the language binder sees the arguments
statement ok
CREATE FUNCTION defaulted_rows(n := 2) RETURNS TABLE(i BIGINT) LANGUAGE testlang AS 'rows:arg:0';

query I
SELECT count(*) FROM defaulted_rows();
----
2

query I
SELECT count(*) FROM defaulted_rows(n := 4);
----
4

# arguments arrive in parameter declaration order, not caller order
statement ok
CREATE FUNCTION ordered_rows(a INTEGER, b INTEGER := 2, c INTEGER := 3) RETURNS TABLE(i BIGINT) LANGUAGE testlang AS 'rows:arg:1';

query I
SELECT count(*) FROM ordered_rows(c := 7, a := 1, b := 5);
----
5

query I
SELECT count(*) FROM ordered_rows(1);
----
2

# the declared column types are enforced with standard CAST semantics at runtime
statement ok
CREATE FUNCTION narrow() RETURNS TABLE(i TINYINT) LANGUAGE testlang AS 'rows:300';

statement error
SELECT max(i) FROM narrow();
----
<REGEX>:.*Conversion Error.*

# a binder returning a different column count than declared is rejected with both sides named
statement ok
CREATE FUNCTION wide() RETURNS TABLE(i BIGINT) LANGUAGE testlang AS 'rows:1:wide';

statement error
SELECT * FROM wide();
----
<REGEX>:.*declares 1 result columns.*returned a statement with 2 columns.*

# a self-referencing language table function is caught by the recursion guard
statement ok
CREATE FUNCTION recursive_tf() RETURNS TABLE(i BIGINT) LANGUAGE testlang AS 'rows:self';

statement error
SELECT * FROM recursive_tf();
----
<REGEX>:.*infinite recursion detected.*

# the bare RETURNS TABLE form stores an unresolved schema the binder publishes at CREATE
statement ok
CREATE FUNCTION inferred() RETURNS TABLE LANGUAGE testlang AS 'rows:2';

query TT
SELECT return_type, language_version FROM duckdb_functions() WHERE function_name = 'inferred';
----
TABLE(i BIGINT)	testlang 1.0

query I
SELECT i FROM inferred() ORDER BY i;
----
0
1

# binder-published descriptions carry the member's signature and survive member mutations
statement ok
CREATE FUNCTION numbers() RETURNS TABLE(i INTEGER) LANGUAGE testlang AS 'rows:1';

query TT rowsort
SELECT description, parameter_types FROM duckdb_functions() WHERE function_name = 'numbers';
----
testlang: rows:1	[]
testlang: rows:3	[INTEGER]

# replacing a member replaces its description instead of shadowing it with the old one
statement ok
CREATE OR REPLACE FUNCTION numbers(n INTEGER) RETURNS TABLE(i INTEGER, tag VARCHAR) LANGUAGE testlang AS 'rows:5';

query TT
SELECT description, macro_definition FROM duckdb_functions() WHERE function_name = 'numbers' AND parameter_types = ['INTEGER'];
----
testlang: rows:5	rows:5

# a dropped member takes its description with it
statement ok
DROP FUNCTION numbers(INTEGER);

query TT
SELECT description, macro_definition FROM duckdb_functions() WHERE function_name = 'numbers';
----
testlang: rows:1	rows:1

statement ok
DROP FUNCTION numbers;

# an extension-registered aliased type keeps its identity in the declared columns through EXPORT
# (a fresh database, so the import does not collide with this test's other entries)
statement ok
ATTACH ':memory:' AS aex;

statement ok
USE aex;

statement ok
CREATE FUNCTION aliased_tf(x ci_text) RETURNS TABLE(c ci_text) LANGUAGE testlang AS 'rows:1';

query TT
SELECT parameter_types, return_type FROM duckdb_functions() WHERE function_name = 'aliased_tf';
----
[ci_text]	TABLE(c ci_text)

statement ok
EXPORT DATABASE '{TEST_DIR}/language_table_function_demo_export';

statement ok
DROP FUNCTION aliased_tf;

statement ok
IMPORT DATABASE '{TEST_DIR}/language_table_function_demo_export';

query TT
SELECT parameter_types, return_type FROM duckdb_functions() WHERE function_name = 'aliased_tf';
----
[ci_text]	TABLE(c ci_text)

# the informational language version is published by ValidateCreate, also on re-import
query T
SELECT language_version FROM duckdb_functions() WHERE function_name = 'aliased_tf';
----
testlang 1.0

statement ok
DROP FUNCTION aliased_tf;

# an alias that collides with a keyword renders quoted, so the member kind survives the round trip
statement ok
CREATE FUNCTION keyword_alias() RETURNS "table" LANGUAGE testlang AS '7';

statement ok
EXPORT DATABASE '{TEST_DIR}/language_table_function_keyword_alias_export';

statement ok
DROP FUNCTION keyword_alias;

statement ok
IMPORT DATABASE '{TEST_DIR}/language_table_function_keyword_alias_export';

query TTT
SELECT function_type, return_type, macro_definition FROM duckdb_functions() WHERE function_name = 'keyword_alias';
----
macro	table	7

statement ok
DROP FUNCTION keyword_alias;

statement ok
USE memory;

statement ok
DETACH aex;

# scalar language functions keep working with table members around (shared machinery)
statement ok
CREATE FUNCTION scalar_twin() RETURNS INTEGER LANGUAGE testlang AS '42';

statement ok
CREATE FUNCTION scalar_twin() RETURNS TABLE(i INTEGER) LANGUAGE testlang AS 'rows:1';

query I
SELECT scalar_twin();
----
42

query I
SELECT i FROM scalar_twin();
----
0

statement ok
DROP MACRO TABLE scalar_twin;

statement ok
DROP FUNCTION scalar_twin;

# overload selection picks table members by nested user types, like the scalar path
statement ok
CREATE TYPE dmood AS ENUM ('d1');

statement ok
CREATE FUNCTION pick(x dmood[]) RETURNS TABLE(i BIGINT) LANGUAGE testlang AS 'rows:1';

statement ok
CREATE FUNCTION pick(x VARCHAR[]) RETURNS TABLE(i BIGINT) LANGUAGE testlang AS 'rows:2';

query I
SELECT count(*) FROM pick(['d1'::dmood]);
----
1

query I
SELECT count(*) FROM pick(['a']);
----
2

# views over language table functions re-bind through the seam
statement ok
CREATE FUNCTION viewed(n INTEGER) RETURNS TABLE(i INTEGER) LANGUAGE testlang AS 'rows:arg:0';

statement ok
CREATE VIEW v AS SELECT * FROM viewed(2);

query I
SELECT count(*) FROM v;
----
2
