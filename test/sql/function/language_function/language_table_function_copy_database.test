# name: test/sql/function/language_function/language_table_function_copy_database.test
# description: COPY FROM DATABASE copies language table functions and respects the target's storage version
# group: [language_function]

# Language function tests manage their own storage version (persistent entries need v2.1.0+)
require noforcestorage

# no binder registered: the opaque definition still copies
statement ok
CREATE FUNCTION copied_tf(n INTEGER) RETURNS TABLE(i INTEGER, tag VARCHAR) LANGUAGE testlang AS 'rows:3';

# ... including a second overload member
statement ok
CREATE FUNCTION copied_tf() RETURNS TABLE(i INTEGER) LANGUAGE testlang AS 'rows:1';

statement ok
ATTACH ':memory:' AS dst;

statement ok
COPY FROM DATABASE memory TO dst;

query TTTT rowsort
SELECT function_type, language, return_type, macro_definition FROM duckdb_functions() WHERE function_name = 'copied_tf' AND database_name = 'dst';
----
table_macro	testlang	TABLE(i INTEGER)	rows:1
table_macro	testlang	TABLE(i INTEGER, tag VARCHAR)	rows:3

# a target below v2.1.0 rejects the copy instead of writing an entry it cannot represent
statement ok
ATTACH '{TEST_DIR}/language_table_function_copy_old.db' AS old_dst (STORAGE_VERSION 'v2.0.0');

statement error
COPY FROM DATABASE memory TO old_dst;
----
<REGEX>:.*only supported for storage versions v2\.1\.0 and higher.*

# a v2.1.0 target accepts it
statement ok
ATTACH '{TEST_DIR}/language_table_function_copy_new.db' AS new_dst (STORAGE_VERSION 'v2.1.0');

statement ok
COPY FROM DATABASE memory TO new_dst;

query TT rowsort
SELECT return_type, macro_definition FROM duckdb_functions() WHERE function_name = 'copied_tf' AND database_name = 'new_dst';
----
TABLE(i INTEGER)	rows:1
TABLE(i INTEGER, tag VARCHAR)	rows:3

statement ok
DETACH old_dst;

statement ok
DETACH new_dst;

statement ok
DETACH dst;
