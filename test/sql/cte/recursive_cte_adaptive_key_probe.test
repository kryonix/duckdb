query III
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	SELECT i, 0
	FROM range(current_setting('standard_vector_size')::INTEGER * 128) input(i)
	UNION ALL
	SELECT candidate.k, coalesce(state.v, 0) + 1
	FROM range(current_setting('standard_vector_size')::INTEGER * 128) candidate(k)
	LEFT JOIN recurring.t state USING (k)
	WHERE coalesce(state.v, 0) < 8
)
SELECT count(*) = current_setting('standard_vector_size')::BIGINT * 128,
       max(v) = 8,
       sum(v)::BIGINT = current_setting('standard_vector_size')::BIGINT * 128 * 8
FROM t;
----
1	1	1

