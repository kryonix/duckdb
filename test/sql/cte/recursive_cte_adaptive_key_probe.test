# name: test/sql/cte/recursive_cte_adaptive_key_probe.test
# description: Adaptive complete-key non-inner probes over frozen USING KEY state
# group: [cte]

statement ok
SET threads=1;

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

statement ok
PRAGMA explain_output='physical_only';

# A visited-set anti join remains a hash join with an adaptive complete-key probe capability.
query II
EXPLAIN WITH RECURSIVE reach(node, depth) USING KEY (node) AS (
	VALUES (0, 0)
	UNION ALL
	SELECT candidate, next_depth
	FROM (SELECT node + 1 AS candidate, depth + 1 AS next_depth FROM reach WHERE depth < 6) next
	ANTI JOIN recurring.reach seen ON seen.node = candidate
)
SELECT * FROM reach;
----
physical_plan	<REGEX>:.*HASH_JOIN.*Recursive Key Probe.*ADAPTIVE.*

# A SEMI join flipped by build/probe optimization is normalized back to a candidate-left adaptive probe.
query II
EXPLAIN WITH RECURSIVE t(k, v) USING KEY (k) AS (
	SELECT i, CASE WHEN i = 0 THEN 0 ELSE 100 END
	FROM range(64) input(i)
	UNION ALL
	SELECT n.k, n.v + 1
	FROM (SELECT * FROM t WHERE v < 8 LIMIT 1) n
	SEMI JOIN recurring.t s USING (k)
)
SELECT count(*), sum(v) FROM t;
----
physical_plan	<REGEX>:.*HASH_JOIN.*Join Type: SEMI.*Recursive Key Probe: ADAPTIVE.*

query II
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	SELECT i, CASE WHEN i = 0 THEN 0 ELSE 100 END
	FROM range(64) input(i)
	UNION ALL
	SELECT n.k, n.v + 1
	FROM (SELECT * FROM t WHERE v < 8 LIMIT 1) n
	SEMI JOIN recurring.t s USING (k)
)
SELECT count(*), sum(v) FROM t;
----
64	6308

# LEFT probes preserve matched recurring payloads after switching away from the hash-table build.
query IIII
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	VALUES (0, 0)
	UNION ALL
	SELECT n.k + 1, s.v + 1
	FROM t n
	LEFT JOIN recurring.t s ON s.k = n.k
	WHERE n.k < 6
)
SELECT count(*), min(v), max(v), sum(v) FROM t;
----
7	0	6	21

# Missing LEFT probes retain the probe row and produce a NULL state payload.
query III
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	VALUES (0, 0)
	UNION ALL
	SELECT n.k + 1, coalesce(s.v, n.v) + 1
	FROM t n
	LEFT JOIN recurring.t s ON s.k = n.k + 100
	WHERE n.k < 6
)
SELECT count(*), max(k), max(v) FROM t;
----
7	6	6

# Nested state payloads retain their values and produce typed NULLs for missing LEFT matches.
query III
WITH RECURSIVE t(k, payload, depth) USING KEY (k) AS (
	VALUES (0, [1, 2], 0)
	UNION ALL
	SELECT n.k + 1, list_append(coalesce(s.payload, n.payload), n.depth + 3), n.depth + 1
	FROM t n
	LEFT JOIN recurring.t s ON s.k = n.k + 100
	WHERE n.depth < 6
)
SELECT count(*), max(len(payload)), sum(len(payload)) FROM t;
----
7	8	35

# SEMI probes retain duplicate probe rows; keyed UNION aggregation observes both rows.
query II
WITH RECURSIVE t(k, v) USING KEY (k, sum(v) AS v) AS (
	VALUES (1, 0)
	UNION
	SELECT n.k, 1
	FROM t n
	CROSS JOIN range(2) duplicate
	SEMI JOIN recurring.t s ON s.k = n.k
	WHERE n.v < 8
)
SELECT k, v FROM t;
----
1	8

# Ordinary NULL equality misses while null-safe equality finds the keyed state row.
query TI rowsort
WITH RECURSIVE ordinary(k, v) USING KEY (k) AS (
	VALUES (NULL::INTEGER, 0)
	UNION ALL
	SELECT n.k, CASE WHEN s.v IS NULL THEN n.v + 1 ELSE s.v + 10 END
	FROM ordinary n
	LEFT JOIN recurring.ordinary s ON s.k = n.k
	WHERE n.v < 3
), null_safe(k, v) USING KEY (k) AS (
	VALUES (NULL::INTEGER, 0)
	UNION ALL
	SELECT n.k, CASE WHEN s.v IS NULL THEN n.v + 1 ELSE s.v + 10 END
	FROM null_safe n
	LEFT JOIN recurring.null_safe s ON s.k IS NOT DISTINCT FROM n.k
	WHERE n.v < 30
)
SELECT 'ordinary', v FROM ordinary
UNION ALL
SELECT 'null_safe', v FROM null_safe;
----
null_safe	30
ordinary	3

# Collated probe keys use the same normalized identity as the recurring table.
query TI
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	SELECT 'a' COLLATE nocase, 0
	UNION ALL
	SELECT n.k, s.v + 1
	FROM (SELECT upper(k) AS k, v FROM t) n
	LEFT JOIN recurring.t s ON s.k IS NOT DISTINCT FROM n.k
	WHERE n.v < 4
)
SELECT k, v FROM t;
----
a	4

statement ok
