query III
WITH RECURSIVE projected(k, value, carried) USING KEY (k) AS (
	SELECT i, 0, i FROM range(4) input(i)
	UNION ALL
	SELECT n.k, s.value + 1, n.carried
	FROM projected n
	LEFT JOIN (SELECT abs(k) AS k, value FROM recurring.projected) s USING (k)
	WHERE n.value < 2
)
SELECT count(*), sum(value), sum(carried) FROM projected;
