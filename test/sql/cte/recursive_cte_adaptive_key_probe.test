query III
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	VALUES (0, 0)
	UNION ALL
	SELECT n.k + 1, coalesce(s.v, n.v) + 1
	FROM t n
	LEFT JOIN recurring.t s ON s.k = n.k + 100
	WHERE n.k < 4
)
SELECT count(*), max(k), max(v) FROM t;
----
5	4	4

