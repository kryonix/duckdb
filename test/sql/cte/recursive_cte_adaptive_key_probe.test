# Repeated nested invocations must not inherit the prior invocation's decision or hash-table binding.
statement ok
CALL enable_logging('PhysicalOperator');

statement ok
CALL truncate_duckdb_logs();

query II rowsort
WITH RECURSIVE outer_cte(a, b) AS (
	SELECT 1, 1
	UNION
	(
		WITH RECURSIVE inner_cte(k, v) USING KEY (k) AS (
			SELECT a, 0 FROM outer_cte WHERE b < 4
			UNION ALL
			SELECT candidate, next_v
			FROM (SELECT k + 1 AS candidate, v + 1 AS next_v FROM inner_cte WHERE v < 6) next
			ANTI JOIN recurring.inner_cte seen ON seen.k = candidate
		)
		SELECT k - 6, b + 1
		FROM inner_cte, outer_cte
		WHERE v = 6 AND b < 4
	)
)
SELECT * FROM outer_cte;
----
1	1
1	2
1	3
1	4

statement ok
CALL disable_logging();

query II
SELECT count(*) >= 3,
       count(*) FILTER (WHERE info.adaptive_direct_probe_epochs::UBIGINT > 0) >= 3
FROM duckdb_logs_parsed('PhysicalOperator')
WHERE class = 'PhysicalRecursiveCTE' AND event = 'RuntimeMetrics'
  AND info.adaptive_hash_probe_epochs::UBIGINT > 0;
----
1	1

# Reordered composite keys mix ordinary and null-safe equality in the direct LEFT path.
query III
WITH RECURSIVE t(k1, k2, v) USING KEY (k1, k2) AS (
	SELECT CASE WHEN i = 0 THEN NULL ELSE i::INTEGER END, i::INTEGER, 0
	FROM range(64) input(i)
	UNION ALL
	SELECT n.k1, n.k2, s.v + 1
	FROM t n
	LEFT JOIN recurring.t s
	  ON s.k2 = n.k2 AND s.k1 IS NOT DISTINCT FROM n.k1
	WHERE n.k1 IS NULL AND n.v < 4
)
SELECT count(*), max(v), sum(v) FROM t;
----
64	4	4

# Several input vectors may probe the frozen state concurrently.
statement ok
SET threads=4;

query III
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	SELECT i::INTEGER, 0 FROM range(2048) input(i)
	UNION ALL
	SELECT n.k, s.v + 1
	FROM t n
	LEFT JOIN recurring.t s ON s.k = n.k
	WHERE n.k < 32 AND n.v < 4
)
SELECT count(*), max(v), sum(v) FROM t;
----
2048	4	128

statement ok
SET threads=1;

