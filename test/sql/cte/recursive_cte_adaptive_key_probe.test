# Duplicate-heavy complete-key access never crosses the direct-probe density gate.
query II
WITH RECURSIVE t(k, v) USING KEY (k, sum(v) AS v) AS (
	VALUES (1, 0)
	UNION
	SELECT n.k, 1
	FROM t n
	CROSS JOIN range(16) duplicate
	SEMI JOIN recurring.t s ON s.k = n.k
	WHERE n.v < 64
)
SELECT k, v FROM t;
----
1	64

