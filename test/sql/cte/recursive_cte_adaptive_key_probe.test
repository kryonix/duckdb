# Partial keys and filtered state inputs retain the generic hash-join path.
statement ok
CALL enable_logging('PhysicalOperator');

statement ok
CALL truncate_duckdb_logs();

query I
WITH RECURSIVE partial(k1, k2, v) USING KEY (k1, k2) AS (
	VALUES (1, 1, 0)
	UNION ALL
	SELECT n.k1, n.k2 + 1, n.v + 1
	FROM partial n
	ANTI JOIN recurring.partial s ON s.k1 = n.k1
)
SELECT count(*) FROM partial;
----
1

query I
WITH RECURSIVE filtered(k, v) USING KEY (k) AS (
	VALUES (0, 0)
	UNION ALL
	SELECT n.k + 1, n.v + 1
	FROM filtered n
	ANTI JOIN (SELECT k FROM recurring.filtered WHERE v >= 0) s ON s.k = n.k + 1
	WHERE n.k < 2
)
SELECT count(*) FROM filtered;
----
3

