query III
WITH RECURSIVE t(k, depth) USING KEY (k) AS (
	SELECT i, CASE WHEN i = 0 THEN 0 ELSE 100 END
	FROM range(64) input(i)
	UNION ALL
	SELECT candidate, current.depth + 1
	FROM (SELECT k + 64 AS candidate, k AS source FROM t WHERE depth < 8) next
	LEFT JOIN recurring.t current ON current.k = next.source
	ANTI JOIN recurring.t seen ON seen.k = next.candidate
)
SELECT count(*), max(depth) FILTER (WHERE k >= 64), sum(depth) FROM t;
----
72	8	6336

