# Reordered composite keys mix ordinary and null-safe equality in the direct LEFT path.
query III
WITH RECURSIVE t(k1, k2, v) USING KEY (k1, k2) AS (
	SELECT CASE WHEN i = 0 THEN NULL ELSE i::INTEGER END, i::INTEGER, 0
	FROM range(64) input(i)
	UNION ALL
	SELECT n.k1, n.k2, s.v + 1
	FROM t n
	LEFT JOIN recurring.t s
	  ON s.k2 = n.k2 AND s.k1 IS NOT DISTINCT FROM n.k1
	WHERE n.k1 IS NULL AND n.v < 4
)
SELECT count(*), max(v), sum(v) FROM t;
----
64	4	4

# Several input vectors may probe the frozen state concurrently.
statement ok
SET threads=4;

query III
WITH RECURSIVE t(k, v) USING KEY (k) AS (
	SELECT i::INTEGER, 0 FROM range(2048) input(i)
	UNION ALL
	SELECT n.k, s.v + 1
	FROM t n
	LEFT JOIN recurring.t s ON s.k = n.k
	WHERE n.k < 32 AND n.v < 4
)
SELECT count(*), max(v), sum(v) FROM t;
----
2048	4	128

