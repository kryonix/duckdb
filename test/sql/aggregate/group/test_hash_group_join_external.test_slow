# name: test/sql/aggregate/group/test_hash_group_join_external.test_slow
# description: Bounded-memory external Hash GroupJoin execution
# group: [group]

require json

require noforcestorage

require skip_reload

statement ok
SET threads = 4

statement ok
SET preserve_insertion_order = false

statement ok
SET temp_directory = '{TEST_DIR}/hash_group_join_external'

statement ok
SET debug_group_join_strategy = 'force'

statement ok
SET debug_group_join_execution = 'external'

statement ok
CREATE TABLE external_owner AS SELECT i::INTEGER id FROM range(100000) t(i)

statement ok
ALTER TABLE external_owner ADD PRIMARY KEY(id)

statement ok
SET memory_limit = '30MB'

statement ok
PRAGMA enable_profiling = 'json'

statement ok
SET tracked_metrics = ['system.peak_buffer_memory', 'system.peak_temp_dir_size']

statement ok
PRAGMA profiling_output = '{TEST_DIR}/hash_group_join_external.json'

query III
SELECT count(*), sum(n), sum(s) FROM (
	SELECT o.id, count(*) n, sum(p.v) s
	FROM external_owner o
	JOIN (SELECT (i % 125000)::INTEGER id, i::BIGINT v FROM range(5000000) t(i)) p USING (id)
	GROUP BY o.id
)
----
100000	4000000	9949998000000

# The streaming eager build uses the aggregate hash table's adaptive common-radix spill path before probing owners.
statement ok
SET debug_group_join_strategy = 'eager'

statement ok
PRAGMA profiling_output = '{TEST_DIR}/hash_group_join_external_streaming.json'

query III
SELECT count(*), sum(n), sum(s) FROM (
	SELECT o.id, count(*) n, sum(p.v) s
	FROM external_owner o
	JOIN (SELECT (i % 125000)::INTEGER id, i::BIGINT v FROM range(5000000) t(i)) p USING (id)
	GROUP BY o.id
)
----
100000	4000000	9949998000000

statement ok
PRAGMA profiling_output = '{TEST_DIR}/hash_group_join_external_distinct.json'

# DISTINCT retains the materialized external path because one variable-sized state can exceed memory.
query II
EXPLAIN SELECT count(DISTINCT p.v)
FROM external_owner o
JOIN (SELECT 0::INTEGER id, i::BIGINT v FROM range(5000000) t(i)) p USING (id)
GROUP BY o.id
----
physical_plan	<REGEX>:(?s).*Hash Group Join.*MATERIALIZED_OWNER.*Strategy: EXTERNAL.*

query I
SELECT count(DISTINCT p.v)
FROM external_owner o
JOIN (SELECT 0::INTEGER id, i::BIGINT v FROM range(5000000) t(i)) p USING (id)
GROUP BY o.id
----
5000000

statement ok
SET debug_group_join_strategy = 'force'

# A hot non-unique lookup key exercises routed external execution without materializing the owner partition as Values.
statement ok
CREATE TABLE external_general_owner AS
SELECT 0::INTEGER id, (i % 13)::INTEGER payload FROM range(500000) t(i)

statement ok
PRAGMA profiling_output = '{TEST_DIR}/hash_group_join_external_general.json'

query III
SELECT count(*), sum(n), sum(s) FROM (
	SELECT o.payload, count(*) n, sum(p.v) s
	FROM external_general_owner o
	JOIN (VALUES (0, 7::BIGINT)) p(id, v) USING (id)
	GROUP BY o.payload
)
----
13	500000	3500000

statement ok
PRAGMA disable_profiling

statement ok
RESET memory_limit

statement ok
CREATE TEMP TABLE external_metrics AS
SELECT * FROM '{TEST_DIR}/hash_group_join_external.json'
UNION ALL
SELECT * FROM '{TEST_DIR}/hash_group_join_external_streaming.json'
UNION ALL
SELECT * FROM '{TEST_DIR}/hash_group_join_external_distinct.json'
UNION ALL
SELECT * FROM '{TEST_DIR}/hash_group_join_external_general.json'

query III
SELECT count(*), min(system.peak_buffer_memory <= 30000000), min(system.peak_temp_dir_size > 0)
FROM external_metrics
----
4	true	true
