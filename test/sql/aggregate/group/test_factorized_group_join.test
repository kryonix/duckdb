query I
SELECT count(*) FROM (
	(SELECT * FROM fg_ordered_baseline EXCEPT ALL
	 SELECT r.k, list(s.x ORDER BY s.x), list(t.y ORDER BY t.y DESC), first(s.x ORDER BY s.x DESC),
	        string_agg(s.label, ',' ORDER BY s.label DESC), list(DISTINCT s.x ORDER BY s.x)
	 FROM fg_driver r JOIN fg_left s ON r.k = s.k JOIN fg_right t ON r.k = t.k GROUP BY r.k)
	UNION ALL
	(SELECT r.k, list(s.x ORDER BY s.x), list(t.y ORDER BY t.y DESC), first(s.x ORDER BY s.x DESC),
	        string_agg(s.label, ',' ORDER BY s.label DESC), list(DISTINCT s.x ORDER BY s.x)
	 FROM fg_driver r JOIN fg_left s ON r.k = s.k JOIN fg_right t ON r.k = t.k GROUP BY r.k
	 EXCEPT ALL SELECT * FROM fg_ordered_baseline)
) differences
