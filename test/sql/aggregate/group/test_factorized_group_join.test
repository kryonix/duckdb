statement ok
CREATE TEMP TABLE fg_baseline AS
SELECT r.k,
	count(*) AS pair_count,
	count(s.x) AS sx_count,
	count(t.y) AS ty_count,
	sum(r.payload) AS driver_sum,
	sum(s.x) AS sx_sum,
	sum(t.y) AS ty_sum,
	avg(s.x) AS sx_avg,
	avg(t.y) AS ty_avg,
	min(s.x) AS sx_min,
	max(t.y) AS ty_max,
	sum(s.d) AS sd_sum,
	sum(t.d) AS td_sum,
	min(s.label) AS left_label_min,
	max(t.label) AS right_label_max,
	bool_and(s.flag) AS left_all,
	bool_or(t.flag) AS right_any,
	sum(1) AS constant_sum
FROM fg_driver r
JOIN fg_left s ON r.k = s.k
JOIN fg_right t ON r.k = t.k
GROUP BY r.k

statement ok
SET debug_group_join_strategy = 'factorized'

statement ok
PRAGMA explain_output = 'physical_only'

query II
EXPLAIN SELECT r.k, count(*), sum(r.payload), sum(s.x), sum(t.y)
FROM fg_driver r
JOIN fg_left s ON r.k = s.k
JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
physical_plan	<REGEX>:(?s).*Factorized Group Join.*Driver: UNIQUE.*Lookup: DIRECTORY.*

query II
EXPLAIN ANALYZE SELECT r.k, count(*), sum(r.payload), sum(s.x), sum(t.y)
FROM fg_driver r
JOIN fg_left s ON r.k = s.k
JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
analyzed_plan	<REGEX>:(?s).*driver-first target \+ task-local dense factor states.*Runtime Filters:.*driver->left=YES, driver->right=YES.*Dynamic Filters:.*driver_key_0.*

# For k=1, m=3 and n=2. For k=2, m=1 and n=2.
query IIIIII rowsort
SELECT r.k, count(*), sum(r.payload), sum(s.x), sum(t.y), sum(1)
FROM fg_driver r
JOIN fg_left s ON r.k = s.k
JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
1	6	60	10	54	6
2	2	40	10	17	2

query I
SELECT count(*) FROM (
	(SELECT * FROM fg_baseline EXCEPT ALL
	 SELECT r.k, count(*), count(s.x), count(t.y), sum(r.payload), sum(s.x), sum(t.y), avg(s.x), avg(t.y),
	        min(s.x), max(t.y), sum(s.d), sum(t.d), min(s.label), max(t.label), bool_and(s.flag), bool_or(t.flag),
	        sum(1)
	 FROM fg_driver r JOIN fg_left s ON r.k = s.k JOIN fg_right t ON r.k = t.k GROUP BY r.k)
	UNION ALL
	(SELECT r.k, count(*), count(s.x), count(t.y), sum(r.payload), sum(s.x), sum(t.y), avg(s.x), avg(t.y),
	        min(s.x), max(t.y), sum(s.d), sum(t.d), min(s.label), max(t.label), bool_and(s.flag), bool_or(t.flag),
	        sum(1)
	 FROM fg_driver r JOIN fg_left s ON r.k = s.k JOIN fg_right t ON r.k = t.k GROUP BY r.k
	 EXCEPT ALL SELECT * FROM fg_baseline)
) differences
----
0

# Source-local FILTER predicates are evaluated before the opposite factor multiplicity is applied.
query II
EXPLAIN SELECT r.k,
	sum(s.x) FILTER (WHERE s.flag),
	count(t.y) FILTER (WHERE t.flag),
	sum(r.payload) FILTER (WHERE r.payload > 10),
	count(*) FILTER (WHERE s.x > 2)
FROM fg_driver r
JOIN fg_left s ON r.k = s.k
JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
physical_plan	<REGEX>:(?s).*Factorized Group Join.*driver-first target \+ task-local dense factor states.*Estimated Costs:.*Decision:.*Runtime Filters:.*driver->left=YES, driver->right=YES.*

query IIIII rowsort
SELECT r.k,
	sum(s.x) FILTER (WHERE s.flag),
	count(t.y) FILTER (WHERE t.flag),
	sum(r.payload) FILTER (WHERE r.payload > 10),
	count(*) FILTER (WHERE s.x > 2)
FROM fg_driver r
JOIN fg_left s ON r.k = s.k
JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
1	4	3	NULL	2
2	10	1	40	2

# DISTINCT is applied within the source range and is not repeated for opposite-branch duplicates.
query II
EXPLAIN SELECT r.k, count(DISTINCT s.x), count(DISTINCT t.y), sum(DISTINCT s.x)
FROM fg_driver r JOIN fg_left s ON r.k = s.k JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
physical_plan	<REGEX>:(?s).*Factorized Group Join.*

query IIIIII rowsort
SELECT r.k,
	count(DISTINCT s.x),
	count(DISTINCT t.y),
	sum(DISTINCT s.x),
	count(DISTINCT r.payload),
	count(DISTINCT 1)
FROM fg_driver r JOIN fg_left s ON r.k = s.k JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
1	2	2	5	1	1
2	1	1	5	1	1

query III rowsort
SELECT r.k,
	count(DISTINCT s.x) FILTER (WHERE s.flag),
	count(DISTINCT t.y) FILTER (WHERE t.flag)
FROM fg_driver r JOIN fg_left s ON r.k = s.k JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
1	1	1
2	1	1

