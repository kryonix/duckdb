# Missing preserved factors execute one physical NULL row, including source-local expressions and filters.
query IIIII rowsort
SELECT r.k,
	count(*) FILTER (WHERE s.x IS NULL),
	count(s.x),
	sum(coalesce(s.x, 42)),
	count(*) FILTER (WHERE t.y IS NULL)
FROM fg_driver r LEFT JOIN fg_left s ON r.k = s.k LEFT JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
1	2	4	94	0
2	0	2	10	1
3	0	1	9	1
4	1	0	42	0
5	1	0	42	1

query III rowsort
SELECT r.k, count(DISTINCT coalesce(s.x, 42)), count(DISTINCT s.x)
FROM fg_driver r LEFT JOIN fg_left s ON r.k = s.k LEFT JOIN fg_right t ON r.k = t.k
GROUP BY r.k
----
1	3	2
2	1	1
3	1	1
4	1	0
5	1	0

