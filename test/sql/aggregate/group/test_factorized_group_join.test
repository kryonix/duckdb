# Deterministic pseudo-random factors cover skew, duplicate chains, NULLs, misses, and parallel multi-vector input.
statement ok
CREATE TABLE fg_random_driver(k BIGINT PRIMARY KEY, payload BIGINT)

statement ok
INSERT INTO fg_random_driver SELECT i, (hash(i) % 10000)::BIGINT FROM range(3000) t(i)

statement ok
CREATE TABLE fg_random_left AS
SELECT CASE WHEN i % 19 = 0 THEN NULL WHEN i % 11 = 0 THEN 0
	            WHEN i % 7 = 0 THEN 4000 + (hash(i) % 1000) ELSE hash(i) % 3000 END::BIGINT AS k,
	   (hash(i + 17) % 1000)::BIGINT AS x
FROM range(25000) t(i)

statement ok
CREATE TABLE fg_random_right AS
SELECT CASE WHEN i % 23 = 0 THEN NULL WHEN i % 13 = 0 THEN 0
	            WHEN i % 5 = 0 THEN 5000 + (hash(i) % 1000) ELSE hash(i) % 3000 END::BIGINT AS k,
	   (hash(i + 29) % 1000)::BIGINT AS y
FROM range(28000) t(i)

statement ok
SET debug_group_join_strategy = 'disabled'

statement ok
CREATE TEMP TABLE fg_random_baseline AS
SELECT r.k, count(*) AS n, sum(r.payload) AS rp, sum(s.x) AS sx, sum(t.y) AS ty, min(s.x) AS mn, max(t.y) AS mx
FROM fg_random_driver r JOIN fg_random_left s USING (k) JOIN fg_random_right t USING (k)
GROUP BY r.k

statement ok
SET debug_group_join_strategy = 'factorized'

