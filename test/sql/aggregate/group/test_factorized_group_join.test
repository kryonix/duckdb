	 FROM fg_random_driver r JOIN fg_random_left s USING (k) JOIN fg_random_right t USING (k) GROUP BY r.k)
	UNION ALL
	(SELECT r.k, count(*), sum(r.payload), sum(s.x), sum(t.y), min(s.x), max(t.y)
	 FROM fg_random_driver r JOIN fg_random_left s USING (k) JOIN fg_random_right t USING (k) GROUP BY r.k
	 EXCEPT ALL SELECT * FROM fg_random_baseline)
