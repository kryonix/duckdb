analyzed_plan	<REGEX>:(?s).*driver-first target \+ compact routed factor updates.*Left Mode: CACHED.*Right Mode: EAGER.*Runtime Filters:.*driver->left=YES, driver->right=YES.*Left Matched Factor Rows: 10.*Right Matched Factor Rows: 40.*

# Ordered states can be cached and combined; DISTINCT branches conservatively remain LAZY.
query I
SELECT count(*) FROM (
	(SELECT r.k, r.payload, count(*) AS n, sum(s.x) AS sx, sum(t.y) AS ty,
	        list(s.x ORDER BY s.x) AS ordered_s
	 FROM fg_duplicate_driver r JOIN fg_cached_left s USING (k) JOIN fg_eager_right t USING (k)
	 GROUP BY r.k, r.payload
	 EXCEPT ALL
	 SELECT k, payload, n, sx, ty, ordered_s FROM fg_route_cache_baseline)
	UNION ALL
	(SELECT k, payload, n, sx, ty, ordered_s FROM fg_route_cache_baseline
	 EXCEPT ALL
	 SELECT r.k, r.payload, count(*), sum(s.x), sum(t.y), list(s.x ORDER BY s.x)
	 FROM fg_duplicate_driver r JOIN fg_cached_left s USING (k) JOIN fg_eager_right t USING (k)
	 GROUP BY r.k, r.payload)
) differences
