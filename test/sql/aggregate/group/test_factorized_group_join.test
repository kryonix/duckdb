statement ok
CREATE VIEW fg_reject_coarse_group AS
SELECT r.payload, count(*)
FROM fg_driver r JOIN fg_left s ON r.k=s.k JOIN fg_right t ON r.k=t.k GROUP BY r.payload

statement ok
CREATE VIEW fg_reject_cross_branch AS
SELECT r.k, sum(s.x * t.y)
FROM fg_driver r JOIN fg_left s ON r.k=s.k JOIN fg_right t ON r.k=t.k GROUP BY r.k

statement ok
CREATE VIEW fg_reject_driver_branch AS
SELECT r.k, sum(r.payload + s.x)
FROM fg_driver r JOIN fg_left s ON r.k=s.k JOIN fg_right t ON r.k=t.k GROUP BY r.k

statement ok
CREATE VIEW fg_reject_cross_filter AS
SELECT r.k, sum(s.x) FILTER (WHERE t.y > 0)
FROM fg_driver r JOIN fg_left s ON r.k=s.k JOIN fg_right t ON r.k=t.k GROUP BY r.k

statement ok
CREATE VIEW fg_reject_ordered AS
SELECT r.k, list(s.x ORDER BY t.y)
FROM fg_driver r JOIN fg_left s ON r.k=s.k JOIN fg_right t ON r.k=t.k GROUP BY r.k

statement ok
CREATE VIEW fg_reject_outer AS
SELECT r.k, count(*)
FROM (fg_driver r JOIN fg_right t ON r.k=t.k) RIGHT JOIN fg_left s ON r.k=s.k GROUP BY r.k

statement ok
CREATE VIEW fg_reject_preserved_factor_group AS
SELECT s.k, count(*)
FROM fg_driver r LEFT JOIN fg_left s ON r.k=s.k LEFT JOIN fg_right t ON r.k=t.k GROUP BY s.k

statement ok
CREATE VIEW fg_reject_nonequality AS
SELECT r.k, count(*)
FROM fg_driver r JOIN fg_left s ON r.k<s.k JOIN fg_right t ON r.k=t.k GROUP BY r.k

statement ok
CREATE VIEW fg_reject_residual AS
SELECT r.k, count(*)
FROM fg_driver r JOIN fg_left s ON r.k=s.k AND s.x>r.payload JOIN fg_right t ON r.k=t.k GROUP BY r.k

statement ok
CREATE VIEW fg_reject_four_way AS
SELECT r.k, count(*)
FROM fg_driver r JOIN fg_left s ON r.k=s.k JOIN fg_right t ON r.k=t.k JOIN fg_hot_left u ON r.k=u.k
GROUP BY r.k

foreach reject fg_reject_coarse_group fg_reject_cross_branch fg_reject_driver_branch fg_reject_cross_filter fg_reject_ordered fg_reject_outer fg_reject_preserved_factor_group fg_reject_nonequality fg_reject_residual fg_reject_four_way

query II
EXPLAIN SELECT * FROM {reject}
