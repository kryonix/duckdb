# Routed caching aggregates once per complete join key. CACHED retains task-local fragments; EAGER merges them
# before expanding the route to its output groups.
statement ok
CREATE TABLE fg_cached_left AS SELECT 1::INTEGER AS k, i::INTEGER AS x FROM range(10) t(i)

statement ok
CREATE TABLE fg_eager_right AS SELECT 1::INTEGER AS k, i::INTEGER AS y FROM range(40) t(i)

statement ok
SET debug_group_join_strategy = 'disabled'

statement ok
SET ordered_aggregate_threshold = 4

statement ok
CREATE TEMP TABLE fg_route_cache_baseline AS
SELECT r.k, r.payload, count(*) AS n, sum(s.x) AS sx, sum(t.y) AS ty,
	count(DISTINCT s.x) AS dsx, list(s.x ORDER BY s.x) AS ordered_s
FROM fg_duplicate_driver r JOIN fg_cached_left s USING (k) JOIN fg_eager_right t USING (k)
GROUP BY r.k, r.payload

statement ok
SET debug_group_join_strategy = 'factorized'

query II
EXPLAIN SELECT r.k, r.payload, count(*), sum(s.x), sum(t.y), count(DISTINCT s.x), list(s.x ORDER BY s.x)
FROM fg_duplicate_driver r JOIN fg_cached_left s USING (k) JOIN fg_eager_right t USING (k)
GROUP BY r.k, r.payload
