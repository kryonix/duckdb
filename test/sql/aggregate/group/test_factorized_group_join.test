# name: test/sql/aggregate/group/test_factorized_group_join.test
# description: Factorized two-branch GroupJoin correctness, eligibility, and fallback
# group: [group]

statement ok
SET threads = 1

statement ok
SET debug_group_join_strategy = 'disabled'

statement ok
CREATE TABLE fg_driver(k INTEGER PRIMARY KEY, payload INTEGER)

statement ok
