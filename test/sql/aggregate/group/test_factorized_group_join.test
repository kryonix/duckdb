CREATE TEMP TABLE fg_ordered_baseline AS
SELECT r.k,
	list(s.x ORDER BY s.x) AS sx_list,
	list(t.y ORDER BY t.y DESC) AS ty_list,
	first(s.x ORDER BY s.x DESC) AS sx_first,
	string_agg(s.label, ',' ORDER BY s.label DESC) AS labels,
	list(DISTINCT s.x ORDER BY s.x) AS sx_distinct
FROM fg_driver r JOIN fg_left s ON r.k = s.k JOIN fg_right t ON r.k = t.k
GROUP BY r.k

statement ok
SET debug_group_join_strategy = 'factorized'

