foreach mode serial local ownership external auto

statement ok
SET debug_group_join_execution = '{mode}'

query III
SELECT count(*), sum(n), sum(s) FROM (
	SELECT o.id, count(*) n, sum(p.value) s
	FROM gj_parallel_owner o JOIN gj_parallel_probe p USING (id)
	GROUP BY o.id
)
