FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
1	1	10	3	1
2	1	5	3	1

query II
SELECT count(*), sum(n) FROM (
	SELECT o.id, count(DISTINCT p.value % 10) n
	FROM gj_parallel_owner o JOIN gj_parallel_probe p USING (id)
	GROUP BY o.id
)
----
