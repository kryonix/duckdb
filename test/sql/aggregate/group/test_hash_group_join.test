# Decorrelated scalar aggregates use EMPTY_AGGREGATE rather than LEFT-join row semantics. The owner input can contain
# duplicate and NULL correlation keys: one state is shared per key while every original owner row is emitted.
statement ok
CREATE TABLE gj_static_owner(k INTEGER, label VARCHAR)

statement ok
INSERT INTO gj_static_owner VALUES (1, 'a'), (1, 'b'), (2, 'c'), (NULL, 'n')

statement ok
CREATE TABLE gj_static_probe(k INTEGER, value INTEGER, flag BOOLEAN)

statement ok
INSERT INTO gj_static_probe VALUES (1, 10, true), (1, 20, false), (NULL, 7, true), (3, 30, true)

query II
EXPLAIN SELECT label, (SELECT sum(value) FROM gj_static_probe p WHERE p.k = o.k)
FROM gj_static_owner o
----
physical_plan	<REGEX>:.*Hash Group Join.*EMPTY_AGGREGATE.*STATIC.*

statement ok
SET debug_group_join_strategy = 'disabled'

statement ok
CREATE TEMP TABLE gj_static_baseline AS
SELECT label,
       (SELECT count(*) FROM gj_static_probe p WHERE p.k = o.k) AS c,
       (SELECT sum(value) FILTER (WHERE flag) FROM gj_static_probe p WHERE p.k = o.k) AS s,
       (SELECT list(DISTINCT value ORDER BY value) FROM gj_static_probe p WHERE p.k = o.k) AS l
FROM gj_static_owner o

statement ok
SET debug_group_join_strategy = 'force'

foreach mode serial local ownership external

statement ok
SET debug_group_join_execution = '{mode}'

query TIIT rowsort
SELECT label,
       (SELECT count(*) FROM gj_static_probe p WHERE p.k = o.k),
       (SELECT sum(value) FILTER (WHERE flag) FROM gj_static_probe p WHERE p.k = o.k),
       (SELECT list(DISTINCT value ORDER BY value) FROM gj_static_probe p WHERE p.k = o.k)
FROM gj_static_owner o
----
a	2	10	[10, 20]
b	2	10	[10, 20]
c	0	NULL	NULL
n	0	NULL	NULL

query I
SELECT count(*) FROM (
	(SELECT * FROM gj_static_baseline EXCEPT ALL
	 SELECT label,
	        (SELECT count(*) FROM gj_static_probe p WHERE p.k = o.k),
	        (SELECT sum(value) FILTER (WHERE flag) FROM gj_static_probe p WHERE p.k = o.k),
	        (SELECT list(DISTINCT value ORDER BY value) FROM gj_static_probe p WHERE p.k = o.k)
	 FROM gj_static_owner o)
	UNION ALL
	(SELECT label,
	        (SELECT count(*) FROM gj_static_probe p WHERE p.k = o.k),
	        (SELECT sum(value) FILTER (WHERE flag) FROM gj_static_probe p WHERE p.k = o.k),
	        (SELECT list(DISTINCT value ORDER BY value) FROM gj_static_probe p WHERE p.k = o.k)
	 FROM gj_static_owner o EXCEPT ALL SELECT * FROM gj_static_baseline)
) differences
----
0

endloop

statement ok
RESET debug_group_join_execution

