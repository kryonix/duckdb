# name: test/sql/aggregate/group/test_hash_group_join.test
# description: Physical Hash GroupJoin eligibility and serial/local/ownership execution
# group: [group]

statement ok
CREATE TABLE gj_owner(id INTEGER PRIMARY KEY, payload INTEGER)

statement ok
INSERT INTO gj_owner VALUES (3, 30), (1, 10), (4, 40), (2, 20)

statement ok
CREATE TABLE gj_probe(owner_id INTEGER, value INTEGER, flag BOOLEAN)

statement ok
INSERT INTO gj_probe VALUES
	(1, 10, true), (1, NULL, false), (1, 10, NULL),
	(2, NULL, true), (2, 5, false), (2, 5, true),
	(NULL, 99, true), (5, 100, true)

# The default cost gate retains the mature plan for an unprofitable candidate.
query II
EXPLAIN SELECT o.id, count(*), sum(p.value)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
physical_plan	<!REGEX>:.*Hash Group Join.*

# Materialize a trustworthy result baseline without optimizer rewrites.
statement ok
PRAGMA disable_optimizer

statement ok
CREATE TEMP TABLE gj_baseline AS
SELECT o.id, count(*) AS count_star, count(p.value) AS count_value, sum(p.value) AS sum_value,
       avg(p.value) AS avg_value, min(p.value) AS min_value, max(p.value) AS max_value
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id

statement ok
PRAGMA enable_optimizer

statement ok
SET threads = 1

statement ok
SET debug_group_join_strategy = 'force'

# Force protects an eligible candidate from partial aggregate pushdown and produces a first-class logical GroupJoin.
statement ok
PRAGMA explain_output = 'optimized_only'

query II
EXPLAIN SELECT o.id, count(*), sum(p.value)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
logical_opt	<REGEX>:(?s).*Group Join.*Strategy: SERIAL.*Strategy Costs:.*

# The shared strategy estimate is independent of physical planning and chooses a parallel ownership path at moderate
# fan-out. FILTER is deliberately force-only under AUTO, but still receives a complete strategy estimate.
statement ok
SET threads = 4

query II
EXPLAIN SELECT o.id, count(*), sum(p.value)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
logical_opt	<REGEX>:(?s).*Group Join.*Strategy: OWNERSHIP.*Strategy Costs:.*

query II
EXPLAIN SELECT o.id, sum(p.value) FILTER (WHERE p.flag)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
logical_opt	<REGEX>:(?s).*Group Join.*Strategy: OWNERSHIP.*Strategy Costs:.*

# A conceptual candidate reaches join enumeration before the join tree is rebuilt. The disabled plan joins the tiny
# probe first; forcing HASH retains the proven owner subtree at the aggregate boundary and produces GroupJoin.
statement ok
CREATE TABLE gj_order_owner(id BIGINT PRIMARY KEY, dimension_id BIGINT)

statement ok
INSERT INTO gj_order_owner SELECT i, i FROM range(10000) t(i)

statement ok
CREATE TABLE gj_order_dimension(dimension_id BIGINT PRIMARY KEY)

statement ok
INSERT INTO gj_order_dimension SELECT i FROM range(10000) t(i)

statement ok
CREATE TABLE gj_order_probe(id BIGINT, value BIGINT)

statement ok
INSERT INTO gj_order_probe SELECT i, i FROM range(10) t(i)

statement ok
ANALYZE

statement ok
SET debug_group_join_strategy = 'disabled'

query II
EXPLAIN SELECT o.id, sum(p.value)
FROM (gj_order_owner o JOIN gj_order_dimension d USING (dimension_id)) JOIN gj_order_probe p USING (id)
GROUP BY o.id
----
logical_opt	<!REGEX>:.*Group Join.*

statement ok
SET debug_group_join_strategy = 'hash'

query II
EXPLAIN SELECT o.id, sum(p.value)
FROM (gj_order_owner o JOIN gj_order_dimension d USING (dimension_id)) JOIN gj_order_probe p USING (id)
GROUP BY o.id
----
logical_opt	<REGEX>:(?s).*Group Join.*Conditions: dimension_id = dimension_id.*

query II
SELECT count(*), sum(s) FROM (
	SELECT o.id, sum(p.value) s
	FROM (gj_order_owner o JOIN gj_order_dimension d USING (dimension_id)) JOIN gj_order_probe p USING (id)
	GROUP BY o.id
)
----
10	45

statement ok
SET debug_group_join_strategy = 'force'

statement ok
SET threads = 1

statement ok
SET debug_verify_serializer = true

query III rowsort
SELECT o.id, count(*), sum(p.value)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
1	3	20
2	3	10

statement ok
SET debug_verify_serializer = false

# The conversion is an independently controllable optimizer stage.
statement ok
SET disabled_optimizers = 'group_join'

query II
EXPLAIN SELECT o.id, count(*), sum(p.value)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
logical_opt	<!REGEX>:.*Group Join.*

statement ok
SET disabled_optimizers = ''

statement ok
PRAGMA explain_output = 'physical_only'

# The first-class logical operator selects the physical specialization.
query II
EXPLAIN SELECT o.id, count(*), sum(p.value)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
physical_plan	<REGEX>:.*Hash Group Join.*

query IIIIRII rowsort
SELECT o.id, count(*), count(p.value), sum(p.value), avg(p.value), min(p.value), max(p.value)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
1	3	2	20	10.000000	10	10
2	3	2	10	5.000000	5	5

# The physical operator normalizes either logical child orientation to probe then owner.
query II
EXPLAIN SELECT o.id, count(*)
FROM gj_probe p JOIN gj_owner o ON p.owner_id = o.id
GROUP BY o.id
----
physical_plan	<REGEX>:.*Hash Group Join.*

query III rowsort
SELECT o.id, count(*), sum(p.value)
FROM gj_probe p JOIN gj_owner o ON p.owner_id = o.id
GROUP BY o.id
----
1	3	20
2	3	10

# Compare the forced result bidirectionally with a result materialized under the disabled strategy.
query I
SELECT count(*) FROM (
	(SELECT o.id, count(*), count(p.value), sum(p.value), avg(p.value), min(p.value), max(p.value)
	 FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id GROUP BY o.id
	 EXCEPT ALL SELECT * FROM gj_baseline)
	UNION ALL
	(SELECT * FROM gj_baseline EXCEPT ALL
	 SELECT o.id, count(*), count(p.value), sum(p.value), avg(p.value), min(p.value), max(p.value)
	 FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id GROUP BY o.id)
) differences
----
0

query III rowsort
SELECT o.id, bool_or(p.flag), bool_and(p.flag)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
1	1	0
2	1	0

# Variable-sized aggregate state uses the same generic address-based update and destruction paths.
query II rowsort
SELECT o.id, array_length(list(p.value))
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
----
1	3
2	3

# A probe-side equality key is canonicalized to the owner key.
query III rowsort
SELECT p.owner_id, count(*), sum(p.value)
FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id
GROUP BY p.owner_id
----
1	3	20
2	3	10

# Owner filters and direct projections preserve the catalog uniqueness proof.
query II
EXPLAIN SELECT owner_key, count(*), sum(p.value)
FROM (SELECT id AS owner_key FROM gj_owner WHERE payload >= 20) o
JOIN gj_probe p ON o.owner_key = p.owner_id
GROUP BY owner_key
----
physical_plan	<REGEX>:.*Hash Group Join.*

query III rowsort
SELECT owner_key, count(*), sum(p.value)
FROM (SELECT id AS owner_key FROM gj_owner WHERE payload >= 20) o
JOIN gj_probe p ON o.owner_key = p.owner_id
GROUP BY owner_key
----
2	3	10

