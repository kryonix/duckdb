# UNIQUE is accepted only when every key column is NOT NULL.
statement ok
CREATE TABLE gj_unique_not_null(id INTEGER UNIQUE NOT NULL)

statement ok
INSERT INTO gj_unique_not_null VALUES (1), (2)

query II
EXPLAIN SELECT o.id, count(*) FROM gj_unique_not_null o JOIN gj_probe p ON o.id = p.owner_id GROUP BY o.id
----
physical_plan	<REGEX>:.*Hash Group Join.*

# Rejection cases fall back to the existing plan.
statement ok
CREATE TABLE gj_nonunique(id INTEGER)

statement ok
