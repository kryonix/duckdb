# Force does not suppress the existing eager aggregate rewrite for an ineligible candidate.
statement ok
CREATE TABLE gj_eager_probe(id INTEGER, value INTEGER)

statement ok
INSERT INTO gj_eager_probe SELECT (i % 3) + 1, i FROM range(10000) t(i)

query II
EXPLAIN SELECT o.id, sum(p.value)
FROM gj_nonunique o JOIN gj_eager_probe p ON o.id = p.id
GROUP BY o.id
----
physical_plan	<REGEX>:.*EXPORT_STATE.*

statement ok
RESET debug_group_join_strategy

# The default remains disabled after reset.
query II
EXPLAIN SELECT o.id, count(*) FROM gj_owner o JOIN gj_probe p ON o.id = p.owner_id GROUP BY o.id
----
physical_plan	<!REGEX>:.*Hash Group Join.*

statement ok
SET debug_group_join_strategy = 'auto'

query II
