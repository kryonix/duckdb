# The owner build retains the comparison join's runtime-filter contract and publishes an exact prefix-range filter.
statement ok
CREATE TABLE gj_runtime_filter_owner(id INTEGER)

statement ok
INSERT INTO gj_runtime_filter_owner VALUES (1), (3)

statement ok
CREATE TABLE gj_runtime_filter_probe AS SELECT i::INTEGER id FROM range(10000) t(i)

query II
EXPLAIN ANALYZE SELECT o.id, count(*)
FROM gj_runtime_filter_probe p JOIN gj_runtime_filter_owner o USING (id)
GROUP BY o.id
----
analyzed_plan	<REGEX>:(?s).*Hash Group Join.*IN.*PRF.*

# GroupJoin synthesizes the same owner-derived filter when the owner is the original left child and there is no
# comparison-join build filter to retain.
statement ok
SET disabled_optimizers = 'join_order'

query II
EXPLAIN ANALYZE SELECT o.id, count(*)
FROM gj_runtime_filter_owner o JOIN gj_runtime_filter_probe p USING (id)
GROUP BY o.id
----
analyzed_plan	<REGEX>:(?s).*Hash Group Join.*Dynamic Filters:.*optional: \(id >= 1\).*optional: \(id <= 3\).*

statement ok
SET disabled_optimizers = ''

query II rowsort
SELECT o.id, count(*)
FROM gj_runtime_filter_probe p JOIN gj_runtime_filter_owner o USING (id)
GROUP BY o.id
----
1	1
3	1

