endloop

# Destructive cross-layout combine retains variable-sized aggregate allocations.
foreach mode local ownership external

statement ok
SET debug_group_join_execution = '{mode}'

query II
SELECT count(*), sum(n) FROM (
	SELECT o.id, array_length(list(p.value)) n
	FROM gj_parallel_owner o JOIN gj_parallel_probe p USING (id)
	GROUP BY o.id
)
