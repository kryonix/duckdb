SELECT label,
       (SELECT count(*) FROM gj_static_probe p WHERE p.k = o.k) AS c,
       (SELECT sum(value) FILTER (WHERE flag) FROM gj_static_probe p WHERE p.k = o.k) AS s,
       (SELECT list(DISTINCT value ORDER BY value) FROM gj_static_probe p WHERE p.k = o.k) AS l
FROM gj_static_owner o

statement ok
SET debug_group_join_strategy = 'force'

foreach mode serial local ownership external

statement ok
SET debug_group_join_execution = '{mode}'

query TIIT rowsort
SELECT label,
       (SELECT count(*) FROM gj_static_probe p WHERE p.k = o.k),
       (SELECT sum(value) FILTER (WHERE flag) FROM gj_static_probe p WHERE p.k = o.k),
       (SELECT list(DISTINCT value ORDER BY value) FROM gj_static_probe p WHERE p.k = o.k)
FROM gj_static_owner o
