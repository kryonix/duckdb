# Exercise multiple chunks, vector boundaries, unmatched rows, and a high fan-out group.
statement ok
CREATE TABLE gj_large_owner(id INTEGER PRIMARY KEY)

statement ok
INSERT INTO gj_large_owner SELECT i FROM range(4097) t(i)

statement ok
CREATE TABLE gj_large_probe(id INTEGER, value INTEGER)

statement ok
INSERT INTO gj_large_probe SELECT i % 5000, i FROM range(10000) t(i)

statement ok
INSERT INTO gj_large_probe SELECT 0, i FROM range(5000) t(i)

query II
SELECT count(*), sum(c) FROM (
	SELECT o.id, count(*) c
	FROM gj_large_owner o JOIN gj_large_probe p USING (id)
	GROUP BY o.id
)
----
4097	13194

# Empty/no-match inputs and one-match-per-group all retain INNER semantics.
statement ok
CREATE TABLE gj_empty_owner(id INTEGER PRIMARY KEY)

statement ok
