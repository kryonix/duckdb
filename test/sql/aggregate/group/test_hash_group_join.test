1000	200000

endloop

statement ok
RESET debug_group_join_execution

# Planned AUTO execution chooses task-local memoization for high fan-out and bounded external execution when the
# estimated owner state table exceeds the memory budget.
query II
EXPLAIN SELECT o.id, count(*), sum(p.value)
FROM gj_parallel_owner o JOIN gj_parallel_probe p USING (id)
GROUP BY o.id
----
physical_plan	<REGEX>:(?s).*Hash Group Join.*Strategy: LOCAL.*

statement ok
CREATE TABLE gj_external_eager_owner(a BIGINT, b BIGINT, PRIMARY KEY(a, b))

statement ok
INSERT INTO gj_external_eager_owner SELECT i, i % 17 FROM range(100000) t(i)

statement ok
ANALYZE gj_external_eager_owner

statement ok
SET memory_limit = '30MB'

query II
EXPLAIN SELECT o.id, count(*)
FROM range(100000) o(id) JOIN range(100000) p(id) USING (id)
GROUP BY o.id
----
physical_plan	<REGEX>:(?s).*Hash Group Join.*Strategy: EXTERNAL.*

# AUTO must not select physical eager when the estimated state table requires external execution. The physical layer
# cannot execute that combination and explicit EAGER falls back to bounded memoization instead.
statement ok
SET debug_group_join_strategy = 'auto'

query II
EXPLAIN SELECT o.a, o.b, count(*), sum(p.value), min(p.value), max(p.value)
FROM gj_external_eager_owner o
JOIN (SELECT (i // 100)::BIGINT AS a, ((i // 100) % 17)::BIGINT AS b, i::BIGINT AS value
      FROM range(10000000) t(i)) p USING (a, b)
GROUP BY o.a, o.b
----
physical_plan	<!REGEX>:.*Hash Group Join.*

statement ok
SET debug_group_join_strategy = 'force'

statement ok
RESET memory_limit

statement ok
DROP TABLE gj_external_eager_owner

