# Planning a projection probe child must retain the join's column count while its physical child is constructed.
statement ok
CREATE TABLE gj_projection_owner AS SELECT i::INTEGER id FROM range(10) t(i)

statement ok
ALTER TABLE gj_projection_owner ADD PRIMARY KEY(id)

query III
SELECT count(*), sum(n), sum(s) FROM (
	SELECT o.id, count(*) n, sum(p.value) s
	FROM gj_projection_owner o
	JOIN (SELECT (i % 12)::INTEGER id, i::BIGINT value FROM range(50) t(i)) p USING (id)
	GROUP BY o.id
)
----
10	42	997

