# DISTINCT deduplicates by dense destination ID and arguments before updating the final state. The same probe payload
# can feed several DISTINCT and regular aggregates without changing NULL or FILTER behavior.
foreach mode serial local ownership external

statement ok
SET debug_group_join_execution = '{mode}'

query IIIII rowsort
