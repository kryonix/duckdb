	(1, 1, 5), (1, 1, 7), (1, 2, NULL), (2, 1, 9),
	(NULL, 1, 100), (1, NULL, 100), (9, 9, 100)

query IIII rowsort
SELECT o.b, o.a, count(*), sum(p.value)
FROM gj_composite_owner o
JOIN gj_composite_probe p ON o.a = p.a AND o.b = p.b
GROUP BY o.b, o.a
