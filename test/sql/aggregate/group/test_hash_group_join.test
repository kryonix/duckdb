# Owner-preserving outer joins evaluate each aggregate once against a synthetic NULL probe row for unmatched owners.
foreach mode serial local ownership external

statement ok
SET debug_group_join_execution = '{mode}'

query IIIIIT rowsort
SELECT o.id, count(*), count(p.value), sum(p.value), sum(coalesce(p.value, 5)),
       list(DISTINCT p.value ORDER BY p.value DESC NULLS FIRST)
FROM gj_owner o LEFT JOIN gj_probe p ON o.id = p.owner_id
GROUP BY o.id
